# ============================================================
# NetWorth Tracker - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All variables have sensible defaults for local development.
# Only override what you need to change.
# ============================================================

# ── Database (PostgreSQL) ──
DB_URL=jdbc:postgresql://localhost:5432/networth
DB_NAME=networth
DB_USERNAME=postgres
DB_PASSWORD=

# ── Redis ──
REDIS_URL=redis://localhost:6379
# Required for docker-compose.prod.yml (Redis AUTH)
REDIS_PASSWORD=changeme

# ── JWT Authentication ──
# IMPORTANT: Change this in production! Use a long random string.
JWT_SECRET=change-this-to-a-long-secure-key-in-production-environment

# Browser origins allowed to call the API, comma separated. Dev defaults to the localhost
# front-ends; production has no default and must name its real hostname.
# CORS_ALLOWED_ORIGINS=https://networth.example.com
JWT_ACCESS_EXPIRATION=900000        # 15 minutes (ms)
JWT_REFRESH_EXPIRATION=86400000     # 24 hours (ms)

# ── AI / LLM Configuration ──
AI_SERVER_URL=http://localhost:8082/v1/chat/completions
AI_MODEL=llama
AI_TEMPERATURE=0.1
AI_CONNECT_TIMEOUT=120000           # 2 minutes (ms)
AI_READ_TIMEOUT=300000              # 5 minutes (ms)
AI_MAX_TOOL_ROUNDS=3
AI_TOOL_RESULT_MAX_CHARS=5000
AI_MAX_SESSION_MESSAGES=50
AI_PENDING_ACTION_EXPIRY_DAYS=7
AI_SSE_TIMEOUT=600000               # 10 minutes (ms)
AI_STREAM_TOKENS=true

# ── LLM Docker Settings ──
# Path to directory containing .gguf model files
MODEL_DIR=./models
# Model filename (must exist in MODEL_DIR)
AI_MODEL_FILE=gemma-4-E4B-it-Q4_K_M.gguf
# Context window size (tokens)
AI_CTX_SIZE=32768
# CPU threads for inference
AI_THREADS=8
# Container memory limit for the LLM
LLM_MEMORY_LIMIT=8g

# ── Upstox Broker Integration (OAuth for user holdings import) ──
# Register at https://developer.upstox.com to get credentials
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:3000/holdings

# ── Upstox Market Data (analytics token - separate from broker OAuth) ──
# Used for live stock prices, historical data, MF NAVs
UPSTOX_ANALYTICS_TOKEN=

# ── Zerodha Broker Integration (Kite Connect OAuth) ──
# Register at https://developers.kite.trade to get credentials
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_REDIRECT_URI=http://localhost:3000/holdings

# ── Market Data ──
# Alpha Vantage (free tier: 25 requests/day)
ALPHA_VANTAGE_API_KEY=

# NPS NAV data source (free, no auth required)
NPS_NAV_BASE_URL=https://npsnav.in/api

# ── Google OAuth (Gmail transaction monitoring - optional) ──
# Create credentials at https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/gmail/callback

# ── Email / SMTP ──
MAIL_HOST=localhost
MAIL_PORT=3025
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Encryption ──
# Optional in dev, REQUIRED in production: application-production.properties has no default for
# either, so a missing value fails startup rather than silently disabling protection.
#
# AES-256 key for encrypting uploaded documents at rest - Form 16s, ITR PDFs, bank statements,
# credit card bills. Set any string; it is hashed via SHA-256 to derive a 256-bit key.
# Leave empty to disable file encryption (dev only).
FILE_ENCRYPTION_KEY=

# AES-256 key (32 chars) for encrypting stored Gmail OAuth tokens. A leaked refresh token grants
# continuing access to the user's mailbox, not just to this application.
# Leave empty to store tokens in plaintext (dev only).
TOKEN_ENCRYPTION_KEY=

# ── File Storage ──
UPLOAD_DIR=./uploads

# ── Feature Flags ──
FEATURE_UPSTOX_IMPORT=true
FEATURE_ZERODHA_IMPORT=true

# ── Frontend ──
# Price auto-poll interval in seconds (0 to disable)
VITE_PRICE_POLL_SECONDS=10

# ── Docker / Server ──
# Port the app is accessible on (nginx)
APP_PORT=80
# SERVER_PORT=8080
# SPRING_PROFILES_ACTIVE=production
