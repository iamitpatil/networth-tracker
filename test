478: ## 8. Key Algorithms
479: 
480: ### 8.1 XIRR Calculation (Newton-Raphson)
481: 
482: ```java
483: public double calculateXIRR(List<CashFlow> cashFlows) {
484:     double guess = 0.1;
485:     int maxIterations = 100;
486:     double tolerance = 1e-7;
487:     
488:     for (int i = 0; i < maxIterations; i++) {
489:         double npv = 0;
490:         double derivative = 0;
491:         long daysSinceFirst = DAYS.between(cashFlows.get(0).date(), cashFlows.get(i).date());
492:         
493:         for (CashFlow cf : cashFlows) {
494:             double years = DAYS.between(cashFlows.get(0).date(), cf.date()) / 365.0;
495:             double discount = Math.pow(1 + guess, years);
496:             npv += cf.amount() / discount;
497:             derivative -= cf.amount() * years / Math.pow(1 + guess, years + 1);
498:         }
499:         
500:         if (Math.abs(npv) < tolerance) return guess;
501:         if (derivative == 0) break;
502:         
503:         guess = guess - npv / derivative;
504:     }
505:     
506:     return guess;
507: }
508: ```
509: 
510: ### 8.2 FIFO Cost Basis
511: 
512: ```java
513: public LotCost calculateFIFO(List<BuyLot> lots, double sellQuantity) {
514:     double remaining = sellQuantity;
515:     double totalCost = 0;
516:     
517:     for (BuyLot lot : lots) {
518:         if (remaining <= 0) break;
519:         double fromLot = Math.min(remaining, lot.quantity());
520:         totalCost += fromLot * lot.price();
521:         remaining -= fromLot;
522:     }
523:     
524:     return new LotCost(totalCost / sellQuantity, sellQuantity);
525: }
526: ```
